PORT=5999
HOST=0.0.0.0
MCP_PUBLIC_URL=https://refuel.example.com
AUTH_MODE=bearer
# Generate a long random bearer secret; never commit .env.
MCP_BEARER_TOKEN=
# OAuth mode only: generate with openssl rand -base64 32
JWT_SECRET=
DATABASE_URL=postgresql://refuel:change-me@localhost:5432/refuel
PG_POOL_MAX=10
MCP_DEFAULT_USER_ID=default-user
MCP_DEFAULT_USER_NAME=Fuel Log User
# Required only for AUTH_MODE=oauth
MCP_DEFAULT_USER_EMAIL=
MCP_DEFAULT_USER_PASSWORD=
# Docker Compose only
POSTGRES_PASSWORD=change-me
